{
    "name": "@dusalabs/periphery",
    "version": "0.0.1",
    "description": "",
    "main": "index.js",
    "scripts": {
        "postinstall": "npm link @dusalabs/core",
        "test": "asp --summary",
        "build": "npx massa-as-compile",
        "build:main": "asc assembly/contracts/main.ts -o build/main.wasm --transform @massalabs/as-transformer",
        "build:dca": "asc assembly/contracts/dca.ts -o build/dca.wasm --transform @massalabs/as-transformer",
        "build:maindca": "asc assembly/contracts/mainDCA.ts -o build/mainDCA.wasm --transform @massalabs/as-transformer",
        "build:limit": "asc assembly/contracts/LimitOrder.ts -o build/LimitOrder.wasm --transform @massalabs/as-transformer",
        "build:mainlimit": "asc assembly/contracts/mainLimitOrder.ts -o build/mainLimitOrder.wasm --transform @massalabs/as-transformer",
        "build:LiquidityAmounts": "asc assembly/helpers/LiquidityAmounts.ts -o build/LiquidityAmounts.wasm --transform @massalabs/as-transformer",
        "deploy": "tsx src/deploy.ts",
        "prettier": "prettier assembly//**/*.ts --check && as-prettier --check assembly",
        "prettier:fix": "prettier assembly//**/*.ts --write && as-prettier --write assembly",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "fmt:check": "npm run prettier && npm run lint",
        "fmt": "npm run prettier:fix && npm run lint:fix"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@as-pect/cli": "^8.1.0",
        "@assemblyscript/loader": "^0.27.29",
        "@massalabs/as-transformer": "^0.4.0",
        "@massalabs/as-types": "^2.1.0",
        "@massalabs/eslint-config": "^0.0.11",
        "@massalabs/massa-as-sdk": "^3.0.3-dev.20250617084803",
        "@massalabs/massa-sc-compiler": "^0.2.1-dev",
        "@massalabs/massa-sc-deployer": "^2.2.0",
        "@massalabs/massa-web3": "^5.2.1-dev.20250804095426",
        "@massalabs/prettier-config-as": "^0.0.2",
        "@massalabs/sc-standards": "^1.3.1-dev.20250610123146",
        "@types/node": "^20.10.3",
        "@types/yargs": "^17.0.32",
        "as-bignum": "github:massalabs/as-bignum#0105eb596b2fa707c00712e811a2efdfcb8a9848",
        "assemblyscript": "^0.27.29",
        "dotenv": "^16.3.1",
        "prettier": "^3.1.0",
        "tslib": "^2.6.2",
        "typescript": "^5.3.2"
    },
    "type": "module",
    "prettier": "@massalabs/prettier-config-as",
    "engines": {
        "node": ">=16"
    },
    "dependencies": {
        "tsx": "^4.16.2"
    }
}
